rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isBootstrapAdmin() {
      return isSignedIn() && request.auth.token.email != null && (
        request.auth.token.email.lower() == 'dannyradjkoemar@gmail.com' ||
        request.auth.token.email.lower() == 'partverify-pro@outlook.com'
      );
    }

    function isAdmin() {
      return isBootstrapAdmin() || (
        isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Users collection
    match /users/{userId} {
      // Admins can see all, users can see themselves, or if the document's email matches the authenticated user's email
      allow read: if isOwner(userId) || isAdmin() || (isSignedIn() && request.auth.token.email != null && resource.data.email.lower() == request.auth.token.email.lower());
      
      // Only Admins can create arbitrary user documents, OR an invited user can migrate their own document strictly with role == 'user'
      allow create: if isAdmin() || (
        isOwner(userId) &&
        request.auth.token.email != null &&
        request.resource.data.email.lower() == request.auth.token.email.lower() &&
        request.resource.data.role == 'user'
      );
      
      // Admins can delete any user; an invited user can clean up their temporary invite doc matching their email
      allow delete: if isAdmin() || (
        isSignedIn() &&
        request.auth.token.email != null &&
        resource.data.email.lower() == request.auth.token.email.lower()
      );
      
      // Admins can update anything, users can only update their own TFA settings (never their role or email)
      allow update: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tfaSecret', 'tfaEnabled'])
      );
    }

    // Login attempts (Public write, Admin read/delete)
    match /login_attempts/{attemptId} {
      allow create: if true; // Allow logging even before full auth
      allow read, list, delete: if isAdmin();
    }

    // Clients & Price Lists
    match /clients/{clientId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
      
      match /prices/{priceId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }
    }
  }
}
